# Copy to .env.local and fill in.

# --- Coach (LLM chat) ---------------------------------------------------
# Without a key the coach falls back to a local deterministic analyst that
# answers from the same query layer, so the feature still works offline.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5

# --- Storage ------------------------------------------------------------
# Defaults to ./data/vitalis.db
VITALIS_DB=

# --- Connector credentials ---------------------------------------------
# All connectors run in `demo` mode unless a credential is present. Demo mode
# exercises the real sync engine (pagination, cursors, dedupe, retries) against
# a deterministic local fixture upstream instead of the vendor's servers.
# See src/lib/connectors/README.md for where to drop the live HTTP calls.
FUNCTION_HEALTH_TOKEN=
MYFITNESSPAL_TOKEN=
APPLE_HEALTH_EXPORT_DIR=
ERGDATA_TOKEN=
PELOTON_SESSION_ID=
HRV4TRAINING_TOKEN=
