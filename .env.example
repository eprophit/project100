# Copy to .env.local and fill in.

# --- Coach (LLM chat) ---------------------------------------------------
# Without a key the coach falls back to a local deterministic analyst that
# answers from the same query layer, so the feature still works offline.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5

# --- Storage ------------------------------------------------------------
# Defaults to ./data/vitalis.db
VITALIS_DB=
# Where uploaded exports are kept. Defaults to ./data/imports. Files dropped
# straight into this folder are picked up on the next sync.
VITALIS_IMPORT_DIR=

# --- Sources with a real API -------------------------------------------
# Setting these switches the connector from demo to live and it will call the
# vendor for real.
#
# Concept2 Logbook: an OAuth bearer token with the results:read scope.
ERGDATA_TOKEN=
# Peloton: the value of the peloton_session_id cookie from a logged-in
# browser session. Peloton publishes no official API — these are the private
# endpoints their own web app uses, and they can change without notice.
PELOTON_SESSION_ID=

# --- Sources that have no usable API ------------------------------------
# These four ingest the vendor's export file instead. You can upload one on
# the Connections page at any time without setting anything here.
#
# Set them to a FOLDER PATH to have every export dropped in it ingested on the
# next sync — point one at a Dropbox or iCloud folder and the vendor's own
# scheduled export becomes the integration.
#
# Apple Health   → export.zip from Health → Export All Health Data
APPLE_HEALTH_EXPORT_DIR=
# MyFitnessPal   → Settings → Export Data → Nutrition CSV (arrives by email)
MYFITNESSPAL_TOKEN=
# Function Health → results CSV downloaded from the member dashboard
FUNCTION_HEALTH_TOKEN=
# HRV4Training   → Settings → Export data → CSV
HRV4TRAINING_TOKEN=
